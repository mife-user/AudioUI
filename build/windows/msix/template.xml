<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="audio-ui.exe"
        Arguments=""
        InstallLocation="C:\Program Files\AudioUI\AudioUI">
    </Installer>
    <PackageInformation
        PackageName="AudioUI"
        PackageDisplayName="AudioUI"
        PublisherName="CN=AudioUI"
        PublisherDisplayName="AudioUI"
        Version="0.1.0.0"
        PackageDescription="AudioUI content workbench">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.audioui.desktop"
                Description="AudioUI content workbench"
                DisplayName="AudioUI"
                ExecutableName="audio-ui.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>AudioUI</DisplayName>
            <PublisherDisplayName>AudioUI</PublisherDisplayName>
            <Description>AudioUI content workbench</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="audio-ui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
